TOUR_API_KEY="your_tour_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# ── 카카오 로그인 (기능 9) ──
# 발급처: https://developers.kakao.com > 내 애플리케이션
#   ⓐ 애플리케이션 추가하기
#   ⓑ [제품 설정 > 카카오 로그인] 활성화 ON
#   ⓒ [제품 설정 > 카카오 로그인 > 동의항목] 에서 **닉네임**과 **프로필 사진**을 필수/선택 동의로 추가
#      (이메일은 넣지 말 것 — 비즈 앱 검수가 필요해지고, users 테이블에 저장할 자리도 없다)
#   ⓓ [앱 설정 > 플랫폼 > Web] 에 **사이트 도메인** 2개 등록:
#        https://<프론트>.up.railway.app   (배포)
#        http://localhost:8080             (로컬 개발, flutter run 포트에 맞출 것)
#      → 등록하지 않은 도메인에서 호출하면 카카오가 거부한다.
# Redirect URI는 **등록하지 않아도 된다.** JS SDK 팝업 방식(Q1-B)이라 우리 서버로 돌아오는
# 리다이렉트가 없다 — 카카오 토큰을 프론트가 받아서 우리 API로 POST한다.
#
# [앱 설정 > 앱 키] 화면 상단의 **앱 ID(숫자)**. 제시된 카카오 토큰이 정말 우리 앱에서
# 발급된 것인지 대조하는 데만 쓴다. 비워 두면 그 대조를 건너뛰고 경고 로그만 남으므로
# 개발은 되지만, **운영 배포 전에는 반드시 채울 것** — 비어 있으면 다른 카카오 앱에서
# 발급된 토큰으로도 우리 서비스에 로그인할 수 있다.
KAKAO_APP_ID=""
#
# ⚠️ **JavaScript 키는 여기에 넣지 않는다.** 백엔드는 카카오 앱 키를 하나도 읽지 않는다.
#    JS 키는 프론트가 쓰는 값이라 앱 빌드 시 --dart-define으로 넘긴다(apiBaseUrl과 같은 방식):
#      flutter build web --dart-define=KAKAO_JS_KEY=<JavaScript 키>
#    JS 키가 브라우저에 노출되는 것은 카카오 설계상 정상이며, 위 ⓓ의 도메인 등록으로 보호된다.
#
# ⚠️ 기존 `KAKAO_API_KEY`는 **2026-09-14에 제거됐다.** 선언만 돼 있고 읽는 코드가 0곳이었고,
#    어느 종류의 키인지 알 수 없어 사고 유발 요인이었다(쟁점 F). .env에 남아 있어도 무시된다.

# ── 인증 토큰 (기능 9) ──
# 우리 서버가 발급하는 JWT의 서명 키. **운영에서는 반드시 임의의 긴 문자열로 바꿀 것** —
# 이 값을 아는 사람은 아무 user_id로나 토큰을 위조할 수 있다. 생성 예:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 비워 두면 개발용 기본값이 쓰이고 서버가 기동 시 경고 로그를 남긴다.
# 이 값을 바꾸면 **이미 발급된 토큰이 전부 무효가 된다**(사용자는 재로그인해야 한다).
JWT_SECRET=""

# 토큰 수명(일). 30 = Q6-A 확정(단일 토큰, refresh 없음). 로그인 1회로 상태가 유지되어야
# 한다는 요구에서 나온 값이다. 줄이면 재로그인이 잦아지고, 늘리면 유출 시 노출 창이 길어진다.
# 로그아웃은 클라이언트가 토큰을 지우는 것일 뿐이라 서버가 무효화하지 못한다는 점에 주의.
AUTH_TOKEN_TTL_DAYS=30

# 로컬 개발은 비워두면 SQLite(./livespot.db) 사용. 배포 시 PostgreSQL DSN으로 설정
# 예: postgresql+asyncpg://user:password@host:5432/livespot
# (Phase 2+ 로그인·제보·Credit 등 사용자 데이터용. TourAPI 데이터는 캐싱하지 않고 실시간 호출로 사용)
DATABASE_URL="sqlite+aiosqlite:///./livespot.db"

# 노트북으로 시연할 때만 true로. 실서비스에서는 반드시 false(또는 미설정).
DEMO_BYPASS_GPS=false

# 개발용 여러-테스트유저 시뮬레이션 스위치. 실서비스에서는 반드시 false(또는 미설정).
# 켜면 세 가지가 함께 열린다: ⓐ `X-Test-User-Id` 헤더로 다른 테스트 사용자 행세
# ⓑ `GET /api/dev/test-users` 목록 ⓒ `POST /api/dev/login-as/{id}`로 카카오 없이 진짜 JWT 발급.
# **로그인(기능 9)이 붙은 뒤에도 남겨 뒀다**(Q3-A) — 기능 6(현장 N명)·기능 8(알림)은 사용자가
# 둘 이상 있어야 검증되는데, 카카오 실계정을 여러 개 만들지 않고 QA할 유일한 수단이기 때문이다.
# 단, `Authorization` 헤더가 있으면 ⓐ는 무시된다(실제 로그인이 항상 이긴다).
TEST_MODE=false

# ── 현장 사용자 수 집계 (기능 6) ──
# 현장 사용자 판정 시간창(분). 앱 constants.dart::presenceWindowMinutes와 반드시 같은 값.
PRESENCE_WINDOW_MINUTES=30
# presences 행 실제 삭제 기준(시간). 신호 수신 시 곁다리로 정리한다(별도 배치 없음).
PRESENCE_RETENTION_HOURS=24
# 위치 신호 응답에 동봉하는 답변 대기 질문 최대 건수.
PRESENCE_PENDING_QUESTION_LIMIT=5

# ── AI 브리핑 (기능 10) ──
# GEMINI_API_KEY는 Google AI Studio에서 발급. 키가 없거나 무효여도 서버는 죽지 않고
# 브리핑이 source="TEMPLATE"로 내려간다(앱은 이때 AI 라벨을 붙이지 않는다).
# 모델명이 폐기되면(404 NOT_FOUND) 여기서 새 모델명으로 덮어쓴다.
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_SECONDS=5.0
BRIEFING_CACHE_TTL_SECONDS=21600
BRIEFING_COMMENT_LIMIT=3

# ── Credit 적립 (기능 4) ──
# 제보 +10 / 답변 +5 / 질문 0 (질문은 상수 자체가 없다 — 원장 행을 만들지 않음).
# 이 값을 바꾸면 이미 쌓인 원장 행과 새 행의 기준이 섞인다. 운영 중 변경은 신중히.
CREDIT_AMOUNT_REPORT=10
CREDIT_AMOUNT_ANSWER=5

# 같은 장소에서 하루(KST 자정 기준)에 적립 가능한 최대 건수. 초과해도 제보·답변은
# 정상 저장되고 적립만 건너뛴다.
CREDIT_DAILY_LIMIT_PER_SPOT=3

# ── 질문/답변 알림 (기능 8) ──
# 알림 수명은 설정값이 아니다: 연결된 질문의 유효시간(코드 상수 QUESTION_TTL_HOURS=2)을 그대로 따른다.
# 발송 제한 3종(인원 상한/시간당 상한/재발송 금지)은 2026-09-10 방향 수정으로 폐기됐다.
# → NOTIFICATION_TTL_MINUTES / _MAX_RECIPIENTS / _MAX_PER_USER_PER_HOUR / _RATE_WINDOW_HOURS /
#   _DEDUP_HOURS 는 더 이상 읽지 않는다. 기존 .env에 남아 있어도 무시된다(extra="ignore").
# GET /notifications 한 번에 돌려주는 최대 건수.
NOTIFICATION_LIST_LIMIT=50
